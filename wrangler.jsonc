{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "artboard-ai---tool",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "keep_vars": true,
  "vars": {
    "ENGINE_ORIGIN": "https://artboard-ai-resolution-independent-production.up.railway.app"
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "observability": {
    "enabled": true
  }
}
